# Default: zero-setup local file database, no install required.
DATABASE_URL=sqlite:///./netra.db

# If Postgres is available on the build machine, `pip install -r requirements-postgres.txt`
# then switch to it here — no code changes needed:
# DATABASE_URL=postgresql+psycopg://netra:netra@localhost:5432/netra

# Live scan (Microsoft Graph) — optional. Without these, live scan is simply
# unavailable and the app runs on sample data only. See LIVE_SCAN_SETUP.md.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
